using System;

class Program
{
    static void Main()
    {
        
        int T = Convert.ToInt32(Console.ReadLine());

        for (int i = 0; i < T; i++)
        {
            
            string[] input = Console.ReadLine().Split();
            int X = Convert.ToInt32(input[0]);
            int Y = Convert.ToInt32(input[1]);

           
            if (X < Y)
                Console.WriteLine("FIRST");
            else if (X > Y)
                Console.WriteLine("SECOND");
            else
                Console.WriteLine("ANY");
        }
    }
}
